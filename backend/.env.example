# ConnectCRM Backend - Environment Variables Example
# Duplicate this file as .env for local overrides if needed.
# DO NOT place actual production secrets, passwords, or keys in this file.

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future Stages Configuration (Placeholders for upcoming phases)
# DATABASE_URL=postgresql://user:password@localhost:5432/connectcrm
# WOOCOMMERCE_URL=https://your-store.com
# WOOCOMMERCE_CONSUMER_KEY=ck_placeholder
# WOOCOMMERCE_CONSUMER_SECRET=cs_placeholder
